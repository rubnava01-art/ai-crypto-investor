# Caddy reverse proxy: automatic HTTPS via Let's Encrypt.
# Set DOMAIN in your .env (e.g. DOMAIN=trading.example.com).
{
	auto_https on
}

{$DOMAIN} {
	# API
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Frontend
	handle {
		reverse_proxy frontend:3000
	}

	log {
		output stdout
		format json
	}
}
