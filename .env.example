# ---- AI Crypto Investor — environment template ----
# Copy to .env and fill in. NEVER commit a real .env with secrets.

# App
APP_VERSION=0.1.0
ENVIRONMENT=development

# Database: SQLite for dev. Postgres for production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@db:5432/crypto
DATABASE_URL=sqlite:///./data/app.db

# Auth — CHANGE ALL OF THESE IN PRODUCTION
JWT_SECRET_KEY=CHANGE-ME-use-a-long-random-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
# bcrypt hash of the admin password (generate with the backend helper).
# If empty, the dev default password "admin" is used — DEV ONLY.
ADMIN_PASSWORD_HASH=

# Trading
# Real trading is HARD-DISABLED until Phase 8 criteria are met.
# Do NOT set this to true manually.
REAL_TRADING_ENABLED=false
DEFAULT_SIMULATION_MODE=simulation

# Risk defaults (server-enforced from Phase 3)
INITIAL_CAPITAL_USD=20.00
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_USD=0.40
MAX_TRADES_PER_DAY=3

# Exchange API keys — NOT USED before Phase 5. When used (Phase 5+):
# read-only keys, no withdrawal permission, IP whitelist at the exchange.
# Prefer a secrets manager; env is the minimum acceptable place.
# COINBASE_API_KEY=
# COINBASE_API_SECRET=
# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Alerts (Phase 7) — if unset, alerts are logged, not sent
# ALERT_SMTP_HOST=
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USER=
# ALERT_SMTP_PASSWORD=
# ALERT_EMAIL_FROM=alerts@example.com
# ALERT_EMAIL_TO=

# AI assistant model — default is the local stub (no network, DEMO-labeled).
# For a real OpenAI-compatible endpoint, uncomment and fill in:
# AI_PROVIDER=openai-compatible
# AI_API_URL=https://api.example.com/v1
# AI_API_KEY=
# AI_MODEL=
# The key never leaves the backend and is never logged.
